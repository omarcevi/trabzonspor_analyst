# bash scripts/setup.sh writes this file for you. To write it by hand: copy it to .env and set your project.
# The agents call Gemini in your Google Cloud project (Vertex AI), with your gcloud credentials.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
# One place to change the model for every agent
MODEL=gemini-3.8-flash
